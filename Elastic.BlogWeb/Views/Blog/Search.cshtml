@{
}
@model List<Blog>
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2>Blog Search</h2>
            @if (!Model.Any())
            {
                <div class="alert alert-warning">Sonuç bulunamadı</div>

            }

            <form asp-action="Search" asp-controller="Blog" class="mt-4">
                <div class="input-group input-group-lg">
                    <input type="text" class="form-control" placeholder="Search blogs..." name="searchText" required>
                    <button class="btn btn-primary type="submit">Search</button>
                </div>
            </form>


            <table class="table table-striped table-hover mt-4 form-control">
                    <thead class="table-dark">
                        <tr>
                            <th>Id</th>
                            <th>Title</th>
                            <th>Content</th>
                            <th>UserId</th>             
                            <th>Tags</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Title</td>
                                <td>@(item.Content.Length > 250 ? item.Content.Substring(0, 250) + "..." : item.Content)</td>
                                <td>@item.UserId</td>
                                <td>@String.Join(",",item.Tags)</td>
                                <td>@item.Created.ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            
        </div>
    </div>
</div>
